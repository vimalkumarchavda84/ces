							"        const actualTotal = Number(product.total.toFixed(2));\r",
							"\r",
							"        pm.expect(actualTotal).to.eql(calculatedTotal);\r",
							"    });\r",
							"});\r",
							"pm.test(\"Product discountedTotal is correctly calculated\", function () {\r",
							"    const cart = pm.response.json();\r",
							"\r",
							"    cart.products.forEach(product => {\r",
							"        const expectedDiscountedTotal = Number(\r",
							"            (product.total * (1 - product.discountPercentage / 100)).toFixed(2)\r",
							"        );\r",
							"        const actualDiscountedTotal = Number(\r",
							"            product.discountedTotal.toFixed(2)\r",
							"        );\r",
							"\r",
							"        pm.expect(actualDiscountedTotal).to.eql(expectedDiscountedTotal);\r",
							"    });\r",
							"});\r",
							"pm.test(\"Cart total equals sum of product totals\", function () {\r",
							"    const cart = pm.response.json();\r",
							"\r",
							"    const sumOfTotals = cart.products.reduce(\r",
							"        (sum, product) => sum + product.total,\r",
							"        0\r",
							"    );\r",
							"\r",
							"    pm.expect(Number(cart.total.toFixed(2)))\r",
							"        .to.eql(Number(sumOfTotals.toFixed(2)));\r",
							"});\r",
							"pm.test(\"Product total equals price × quantity\", function () {\r",
