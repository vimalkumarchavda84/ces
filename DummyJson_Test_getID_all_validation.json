					"script": {
						"exec": [
							"pm.test(\"Store all cart IDs\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    const cartIds = jsonData.carts.map(cart => cart.id);\r",
							"\r",
							"    console.log(\"All Cart IDs:\", cartIds);\r",
							"\r",
							"    pm.collectionVariables.set(\"cartIds\", JSON.stringify(cartIds));\r",
							"    pm.collectionVariables.set(\"currentIndex\", 0);\r",
							"});\r",
							"\r",
							"// 👇 Tell Postman what to run next\r",
							"pm.execution.setNextRequest(\"GetbyID\");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
