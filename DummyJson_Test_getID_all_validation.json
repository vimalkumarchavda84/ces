							"if (index < cartIds.length) {\r",
							"    pm.collectionVariables.set(\"cartId\", cartIds[index]);\r",
							"    console.log('getByid called for cartId: ' + cartIds[index] );\r",
							"    pm.collectionVariables.set(\"currentIndex\", index + 1);\r",
							"} else {\r",
							"    console.log(\"All cart IDs executed\");\r",
							"    pm.execution.setNextRequest(null); // stop collection\r",
							"}\r",
							"if (index === cartIds.length) {\r",
							"    pm.execution.setNextRequest(null); // stop collection\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Correct cart is returned\", function () {\r",
							"    pm.expect(pm.response.json().id)\r",
							"        .to.eql(Number(pm.collectionVariables.get(\"cartId\")));\r",
							"});\r",
							"// loop ONLY if IDs are left\r",
							"let cartIds = JSON.parse(pm.collectionVariables.get(\"cartIds\"));\r",
							"let index = Number(pm.collectionVariables.get(\"currentIndex\"));\r",
							"\r",
							"if (index < cartIds.length) {\r",
							"    pm.execution.setNextRequest(\"GetbyID\");\r",
							"}\r",
							"// 👇 Loop back to same request\r",
							"//pm.execution.setNextRequest(\"GetbyID\");\r",
