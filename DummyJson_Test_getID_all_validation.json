							"\r",
							"    pm.expect(cart.products).to.be.an(\"array\").that.is.not.empty;\r",
							"});\r",
							"pm.test(\"Each product has mandatory fields\", function () {\r",
							"    const cart = pm.response.json();\r",
							"\r",
							"    cart.products.forEach(product => {\r",
							"        [\"id\",\"title\",\"price\",\"quantity\",\"total\",\"discountPercentage\",\"discountedTotal\",\"thumbnail\"]\r",
							"            .forEach(field => pm.expect(product).to.have.property(field));\r",
							"    });\r",
							"});\r",
							"pm.test(\"Each product quantity is greater than zero\", function () {\r",
							"    const cart = pm.response.json();\r",
							"\r",
							"    cart.products.forEach(product => {\r",
